rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Modelo: audit/modelo-firestore.md. Proprietário da sessão é imutável.
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (request.auth.token.get('admin', false) == true
        || (request.auth.token.get('email', '') == 'ccbteodoro@gmail.com' && request.auth.token.get('email_verified', false) == true));
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function trainer(uid) {
      return signedIn() && request.auth.token.get('trainer', false) == true
        && exists(/databases/$(database)/documents/vinculos/$(request.auth.uid + '_' + uid))
        && get(/databases/$(database)/documents/vinculos/$(request.auth.uid + '_' + uid)).data.active == true;
    }
    function canRead(uid) { return owner(uid) || admin() || trainer(uid); }
    function shortString(value, max) { return value is string && value.size() <= max; }
    function validSession(d) {
      return d.keys().hasAll(['userId','date','tipo','method','duration_secs','data','timestamp','createdAt','complete','campaignId'])
        && d.keys().hasOnly(['userId','date','tipo','method','duration_secs','data','timestamp','createdAt','complete','campaignId','workoutName'])
        && (!d.keys().hasAny(['workoutName']) || shortString(d.workoutName,120))
        && shortString(d.userId,128) && shortString(d.tipo,160) && shortString(d.method,40)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.duration_secs is number && d.duration_secs >= 0 && d.duration_secs <= 86400
        && d.data is list && d.data.size() >= 1 && d.data.size() <= 200
        && d.createdAt is number && d.complete is bool
        && (d.campaignId == null || shortString(d.campaignId,128)) && d.timestamp is timestamp;
    }
    match /treinos_concluidos/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/treinos_concluidos/$(id)) || canRead(resource.data.userId));
      allow list: if signedIn() && canRead(resource.data.userId);
      allow create: if signedIn() && owner(request.resource.data.userId) && validSession(request.resource.data) && request.resource.data.timestamp == request.time
        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)/exclusoes/$(id));
      allow update: if false;
      allow delete: if signedIn() && (!exists(/databases/$(database)/documents/treinos_concluidos/$(id)) || owner(resource.data.userId))
        && existsAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)/exclusoes/$(id));
    }
    function validCampaign(c) {
      return c is map && c.keys().hasAll(['campaign_data','campaign_count','blacklist','main_method','profile','level','custom_workouts','updatedAt'])
        && c.keys().hasOnly(['campaign_data','campaign_count','blacklist','main_method','profile','level','custom_workouts','updatedAt','deleted_templates'])
        && (!c.keys().hasAny(['deleted_templates']) || shortString(c.deleted_templates,300000))
        && shortString(c.campaign_data,300000) && shortString(c.custom_workouts,300000)
        && shortString(c.blacklist,30000) && shortString(c.campaign_count,12)
        && c.main_method in ['abc','ppl','abcd','biset_agonista','biset_antagonista','biset_sinergista','circuito','calistenia']
        && c.profile in ['hipertrofia','definicao','feminino','tatico']
        && c.level in ['iniciante','intermediario','avancado'] && c.updatedAt is number;
    }
    function validUser(d) { return d.keys().hasAll(['campanha']) && validCampaign(d.campanha); }
    function versionedUser(uid) {
      return request.resource.data.syncVersion is int
        && request.resource.data.syncVersion == (exists(/databases/$(database)/documents/usuarios/$(uid)) ? resource.data.get('syncVersion',0)+1 : 1)
        && shortString(request.resource.data.lastOperation,128)
        && existsAfter(/databases/$(database)/documents/usuarios/$(uid)/sync_operations/$(request.resource.data.lastOperation))
        && getAfter(/databases/$(database)/documents/usuarios/$(uid)/sync_operations/$(request.resource.data.lastOperation)).data.version == request.resource.data.syncVersion
        && getAfter(/databases/$(database)/documents/usuarios/$(uid)/sync_operations/$(request.resource.data.lastOperation)).data.createdAt == request.time;
    }
    match /usuarios/{uid} {
      allow read: if canRead(uid);
      allow create: if owner(uid) && validUser(request.resource.data)
        && (request.resource.data.keys().hasOnly(['campanha']) || (request.resource.data.keys().hasOnly(['campanha','syncVersion','lastOperation']) && versionedUser(uid)));
      allow update: if owner(uid) && validUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['campanha','syncVersion','lastOperation'])
        && ((!resource.data.keys().hasAny(['syncVersion']) && !request.resource.data.keys().hasAny(['syncVersion'])) || versionedUser(uid));
      allow delete: if false;
      match /sync_operations/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasOnly(['version','createdAt','conflicts'])
          && shortString(request.resource.data.conflicts,600000)
          && request.resource.data.createdAt == request.time
          && request.resource.data.version == getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.syncVersion
          && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.lastOperation == id;
        allow update, delete: if false;
      }
      match /exclusoes/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasOnly(['deletedAt']) && request.resource.data.deletedAt == request.time;
        allow update, delete: if false;
      }
    }
    match /jogadores/{uid} { allow read: if owner(uid) || admin(); allow write: if false; }
    match /rankings/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50;
      allow write: if false;
    }
    function validExercise(d) {
      return d.keys().hasAll(['nome','grupo','dica','atualizadoEm']) && d.keys().hasOnly(['nome','grupo','dica','atualizadoEm'])
        && shortString(d.nome,120) && d.nome.size() > 0 && shortString(d.grupo,80)
        && shortString(d.dica,2000) && d.atualizadoEm == request.time;
    }
    match /dicionario/{id} {
      allow read: if signedIn();
      allow create, update: if admin() && validExercise(request.resource.data);
      allow delete: if admin();
    }
    match /vinculos/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
